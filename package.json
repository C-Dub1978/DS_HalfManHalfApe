{
  "name": "@halfmanhalfape/design-system",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve sandbox",
    "build": "ng build",
    "build:lib": "ng build hmha-ui",
    "watch": "ng build --watch --configuration development",
    "test": "ng test hmha-ui --watch=false --browsers=ChromeHeadlessNoSandbox && ng test sandbox --watch=false --browsers=ChromeHeadlessNoSandbox",
    "tokens": "node style-dictionary.config.mjs && node scripts/concat-layers.mjs",
    "tokens:watch": "nodemon --watch tokens --ext json --exec \"npm run tokens\"",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "lint:css": "stylelint \"libs/ui/**/*.css\"",
    "lint:standalone": "if grep -rn '@NgModule' libs apps --include='*.ts'; then echo 'NgModule found — invariant 2' && exit 1; fi",
    "ci": "npm run tokens && npm run tokens:contrast && npm run lint:css && npm run lint:standalone && npm run build:lib && npm test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@types/jasmine": "~5.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "culori": "^4.0.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.3.0",
    "nodemon": "^3.1.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.4",
    "stylelint": "^16.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
