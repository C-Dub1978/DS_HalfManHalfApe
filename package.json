{
  "name": "@acme/ds-workspace",
  "private": true,
  "scripts": {
    "tokens": "style-dictionary build --config style-dictionary.config.mjs && node scripts/concat-layers.mjs",
    "tokens:watch": "nodemon --watch tokens --ext json --exec \"npm run tokens\"",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "lint:css": "stylelint \"libs/ui/**/*.css\"",
    "build:lib": "ng build ds-ui",
    "test": "ng test",
    "ci": "npm run tokens && npm run tokens:contrast && npm run lint:css && npm run build:lib && npm test"
  },
  "devDependencies": {
    "@angular/cli": "^20.0.0",
    "ng-packagr": "^20.0.0",
    "style-dictionary": "^4.3.0",
    "stylelint": "^16.0.0",
    "culori": "^4.0.0"
  }
}
