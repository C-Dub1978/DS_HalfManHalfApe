{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "hmha-ui": {
      "projectType": "library",
      "root": "libs/ui",
      "sourceRoot": "libs/ui/src",
      "prefix": "hmha",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "libs/ui/tsconfig.spec.json",
            "styles": [
              "libs/tokens/src/lib/_all.css"
            ]
          }
        }
      }
    },
    "sandbox": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/sandbox",
      "sourceRoot": "apps/sandbox/src",
      "prefix": "sandbox",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/sandbox/src/main.ts",
            "tsConfig": "apps/sandbox/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/sandbox/public"
              }
            ],
            "styles": [
              "libs/tokens/src/lib/_all.css",
              "apps/sandbox/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sandbox:build:production"
            },
            "development": {
              "buildTarget": "sandbox:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "apps/sandbox/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/sandbox/public"
              }
            ],
            "styles": [
              "libs/tokens/src/lib/_all.css",
              "apps/sandbox/src/styles.css"
            ]
          }
        }
      }
    }
  }
}
