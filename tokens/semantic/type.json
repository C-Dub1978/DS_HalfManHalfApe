{
  "$description": "Semantic type roles, each an explicit size/line/weight triple — no composite tokens, so the CSS output stays plain custom properties. heading-sm/body-sm/caption/label-sm (fork 31) reuse font-size steps already defined in the primitive scale — label-sm shares caption's xs step, same way body-sm/label-md already share sm, distinguished by line/weight, not a dedicated size.",
  "type": {
    "heading-lg": {
      "size": {
        "$value": "{font-size.3xl}"
      },
      "line": {
        "$value": "{line-height.tight}"
      },
      "weight": {
        "$value": "{font-weight.bold}"
      }
    },
    "heading-md": {
      "size": {
        "$value": "{font-size.xl}"
      },
      "line": {
        "$value": "{line-height.tight}"
      },
      "weight": {
        "$value": "{font-weight.semibold}"
      }
    },
    "heading-sm": {
      "size": {
        "$value": "{font-size.lg}"
      },
      "line": {
        "$value": "{line-height.tight}"
      },
      "weight": {
        "$value": "{font-weight.semibold}"
      }
    },
    "body-md": {
      "size": {
        "$value": "{font-size.md}"
      },
      "line": {
        "$value": "{line-height.normal}"
      },
      "weight": {
        "$value": "{font-weight.regular}"
      }
    },
    "body-sm": {
      "size": {
        "$value": "{font-size.sm}"
      },
      "line": {
        "$value": "{line-height.normal}"
      },
      "weight": {
        "$value": "{font-weight.regular}"
      }
    },
    "label-md": {
      "size": {
        "$value": "{font-size.sm}"
      },
      "line": {
        "$value": "{line-height.tight}"
      },
      "weight": {
        "$value": "{font-weight.medium}"
      }
    },
    "label-sm": {
      "size": {
        "$value": "{font-size.xs}"
      },
      "line": {
        "$value": "{line-height.tight}"
      },
      "weight": {
        "$value": "{font-weight.medium}"
      }
    },
    "caption": {
      "size": {
        "$value": "{font-size.xs}"
      },
      "line": {
        "$value": "{line-height.normal}"
      },
      "weight": {
        "$value": "{font-weight.regular}"
      }
    }
  },
  "font": {
    "family": {
      "$value": "{font-family.raleway}"
    },
    "family-heading": {
      "$value": "{font-family.fraunces}"
    },
    "family-mono": {
      "$value": "{font-family.recursive}"
    }
  }
}
