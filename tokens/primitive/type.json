{
  "$description": "Primitive type scales. font-family is a curated set of already-CDN-loaded options (sandbox's index.html, Storybook's preview-head.html, both under libs/ui/README.md's 'Changing fonts' section) — point tokens/semantic/type.json's font.family/font.family-mono at whichever one you want active.",
  "font-family": {
    "$type": "fontFamily",
    "raleway": {
      "$value": "'Raleway', sans-serif"
    },
    "geist": {
      "$value": "'Geist', sans-serif"
    },
    "cormorant": {
      "$value": "'Cormorant', serif"
    },
    "fraunces": {
      "$value": "'Fraunces', serif"
    },
    "recursive": {
      "$value": "'Recursive', monospace"
    },
    "geist-mono": {
      "$value": "'Geist Mono', monospace"
    },
    "jetbrains-mono": {
      "$value": "'JetBrains Mono', monospace"
    },
    "ibm-plex-mono": {
      "$value": "'IBM Plex Mono', monospace"
    }
  },
  "font-size": {
    "$type": "dimension",
    "xs": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "md": {
      "$value": "16px"
    },
    "lg": {
      "$value": "18px"
    },
    "xl": {
      "$value": "20px"
    },
    "2xl": {
      "$value": "24px"
    },
    "3xl": {
      "$value": "30px"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": "400"
    },
    "medium": {
      "$value": "500"
    },
    "semibold": {
      "$value": "600"
    },
    "bold": {
      "$value": "700"
    }
  },
  "line-height": {
    "$type": "number",
    "tight": {
      "$value": "1.2"
    },
    "normal": {
      "$value": "1.5"
    },
    "relaxed": {
      "$value": "1.65"
    }
  }
}
